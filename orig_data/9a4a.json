{"id": 13542, "uuid": "8d90419b-fa2b-48c5-bd8c-4f63c41ea568", "hitokoto": "越是平静的水面，底下的淤泥积得越多。只要轻搅湖水，底下沉积的淤泥就会泛上，然后美丽的湖水就会不复存在。", "type": "c", "from": "樱之诗", "from_who": "SCA-自", "creator": "yueshuxi", "creator_uid": 21234, "reviewer": 20537, "commit_from": "web", "created_at": "1791659637", "length": 51}